<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html>
<html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Lập phiếu nhập - LIBMAN</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="bg-light"><nav class="navbar navbar-dark bg-primary mb-4"><div class="container"><a class="navbar-brand" href="${pageContext.request.contextPath}/import-document-8">LIBMAN</a><span class="navbar-text text-white">Lập phiếu nhập</span></div></nav>
<main class="container pb-5"><div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">Phiếu nhập tạm</h1><a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/import-document-8">Đổi nhà cung cấp</a></div>
    <c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if>
    <c:if test="${not empty success}"><div class="alert alert-success"><c:out value="${success}"/></div></c:if>
    <div class="card card-body shadow-sm mb-4"><div class="row"><div class="col-md-6"><strong>Nhà cung cấp:</strong> <c:out value="${supplier.supplierName}"/> (Mã <c:out value="${supplier.supplierId}"/>)</div><div class="col-md-6"><strong>Thủ thư:</strong> <c:out value="${librarian.fullName}"/> (Mã <c:out value="${librarian.librarianId}"/>)</div></div></div>
    <div class="card card-body shadow-sm mb-4"><h2 class="h5">Tìm tài liệu theo mã</h2>
        <form method="post" action="${pageContext.request.contextPath}/import-document-8" class="row g-2"><input type="hidden" name="action" value="find-document"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><div class="col-md-8"><input class="form-control" name="documentCode" maxlength="30" value="<c:out value='${searchedDocumentCode}'/>" placeholder="Ví dụ: GT-016" required></div><div class="col-md-4"><button class="btn btn-primary" type="submit">Tìm tài liệu</button></div></form>
        <c:if test="${not empty foundDocument}"><div class="alert alert-success mt-3 mb-0"><strong><c:out value="${foundDocument.documentId}"/></strong> - <c:out value="${foundDocument.title}"/>
            <form method="post" action="${pageContext.request.contextPath}/import-document-8" class="row g-2 mt-2"><input type="hidden" name="action" value="add-item"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="documentCode" value="<c:out value='${foundDocument.documentId}'/>">
                <div class="col-md-3"><label class="form-label" for="quantity">Số lượng</label><input class="form-control" id="quantity" name="quantity" type="number" min="1" required></div>
                <div class="col-md-3"><label class="form-label" for="price">Đơn giá</label><input class="form-control" id="price" name="price" type="number" min="0" max="9999999999.99" step="0.01" required></div>
                <div class="col-md-3 align-self-end"><button class="btn btn-success" type="submit">Thêm vào phiếu</button></div>
            </form></div></c:if>
        <c:if test="${empty foundDocument and not empty searchedDocumentCode}"><c:url var="addDocumentUrl" value="/import-document-8"><c:param name="action" value="add-document"/><c:param name="documentId" value="${searchedDocumentCode}"/></c:url><a class="btn btn-outline-primary mt-3" href="${addDocumentUrl}">Thêm tài liệu mới</a></c:if>
    </div>
    <div class="card shadow-sm"><div class="card-body"><h2 class="h5">Chi tiết phiếu nhập</h2>
        <c:choose><c:when test="${not empty details}"><div class="table-responsive"><table class="table table-bordered align-middle"><thead class="table-light"><tr><th>#</th><th>Mã tài liệu</th><th>Tên tài liệu</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th><th>Thao tác</th></tr></thead><tbody>
            <c:forEach var="detail" items="${details}" varStatus="status"><tr><td><c:out value="${status.index + 1}"/></td><td><c:out value="${detail.documentId}"/></td><td><c:out value="${documentsByCode[detail.documentId].title}"/></td>
                <td><input class="form-control form-control-sm" form="edit-${status.index}" name="quantity" type="number" min="1" value="<c:out value='${detail.quantity}'/>" required></td>
                <td><input class="form-control form-control-sm" form="edit-${status.index}" name="price" type="number" min="0" max="9999999999.99" step="0.01" value="<c:out value='${detail.price}'/>" required></td>
                <td><fmt:formatNumber value="${detail.lineTotal}" type="number" minFractionDigits="2" maxFractionDigits="2"/></td><td><form id="edit-${status.index}" method="post" action="${pageContext.request.contextPath}/import-document-8" class="d-inline"><input type="hidden" name="action" value="edit-item"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="index" value="<c:out value='${status.index}'/>"><button class="btn btn-sm btn-outline-primary" type="submit">Sửa</button></form> <form method="post" action="${pageContext.request.contextPath}/import-document-8" class="d-inline"><input type="hidden" name="action" value="remove-item"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="index" value="<c:out value='${status.index}'/>"><button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button></form></td>
            </tr></c:forEach></tbody></table></div><div class="text-end fs-5 mb-3"><strong>Tổng tiền: <fmt:formatNumber value="${totalAmount}" type="number" minFractionDigits="2" maxFractionDigits="2"/> đ</strong></div>
            <form method="post" action="${pageContext.request.contextPath}/import-document-8" onsubmit="return confirm('Lưu phiếu nhập và tạo bản sao tài liệu?');"><input type="hidden" name="action" value="submit-import"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><button class="btn btn-primary" type="submit">Submit phiếu nhập</button></form>
        </c:when><c:otherwise><div class="alert alert-secondary mb-0">Chưa có dòng chi tiết. Hãy tìm và thêm ít nhất một tài liệu.</div></c:otherwise></c:choose>
    </div></div>
</main></body></html>
